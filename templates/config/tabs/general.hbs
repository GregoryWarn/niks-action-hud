<div class="hud-tab-pane {{#if isGeneralTab}}active{{/if}}" data-tab="general">

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Interaction</span><span data-cfg-count="rows"></span>
        </div>
        <div class="hud-cfg-list">
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        <label class="hud-cfg-label">Close menu after action use</label>
                        <span class="hud-cfg-scope world" title="Applies to every player at the table">WORLD</span>
                    </div>
                    <span class="hud-cfg-hint">Automatically dismiss open submenu drawers immediately after rolling an attack, spell, or item.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="closeMenuOnUse" {{#if closeMenuOnUse}}checked{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.hideEmptySubmenus.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.hideEmptySubmenus.active}}
                            {{#if settingLocks.hideEmptySubmenus.canManage}}
                                <a class="hud-lock-icon {{settingLocks.hideEmptySubmenus.type}}" data-setting-key="hideEmptySubmenus" title="{{settingLocks.hideEmptySubmenus.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.hideEmptySubmenus.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.hideEmptySubmenus.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.hideEmptySubmenus.type}}" title="{{settingLocks.hideEmptySubmenus.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Hide empty submenus</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Automatically conceal category buttons (like Spells or Attacks) if the controlled token has no matching items.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="hideEmptySubmenus" {{#if hideEmptySubmenus}}checked{{/if}} {{#if settingLocks.hideEmptySubmenus.disabled}}disabled{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.enableCollapse.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.enableCollapse.active}}
                            {{#if settingLocks.enableCollapse.canManage}}
                                <a class="hud-lock-icon {{settingLocks.enableCollapse.type}}" data-setting-key="enableCollapse" title="{{settingLocks.enableCollapse.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.enableCollapse.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.enableCollapse.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.enableCollapse.type}}" title="{{settingLocks.enableCollapse.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Enable HUD collapse button</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Display a collapse/expand toggle button next to the token name to minimize the Action HUD.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="enableCollapse" {{#if enableCollapse}}checked{{/if}} {{#if settingLocks.enableCollapse.disabled}}disabled{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            {{#if isDnd5eSystem}}
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        <label class="hud-cfg-label">Group actions by activation type</label>
                        <span class="hud-cfg-scope world" title="Applies to every player at the table">WORLD</span>
                    </div>
                    <span class="hud-cfg-hint">Sort and section actions into Action, Bonus Action, Reaction, and Legendary Action headers.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="dnd5eGroupActionsByActivation" {{#if dnd5eGroupActionsByActivation}}checked{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.dnd5eShowUnpreparedRituals.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.dnd5eShowUnpreparedRituals.active}}
                            {{#if settingLocks.dnd5eShowUnpreparedRituals.canManage}}
                                <a class="hud-lock-icon {{settingLocks.dnd5eShowUnpreparedRituals.type}}" data-setting-key="dnd5eShowUnpreparedRituals" title="{{settingLocks.dnd5eShowUnpreparedRituals.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.dnd5eShowUnpreparedRituals.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.dnd5eShowUnpreparedRituals.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.dnd5eShowUnpreparedRituals.type}}" title="{{settingLocks.dnd5eShowUnpreparedRituals.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Show unprepared wizard rituals</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Display known but unprepared ritual spells in the Spellbook for wizard characters, allowing them to cast ritual spells from their spellbook.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="dnd5eShowUnpreparedRituals" {{#if dnd5eShowUnpreparedRituals}}checked{{/if}} {{#if settingLocks.dnd5eShowUnpreparedRituals.disabled}}disabled{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.dnd5eDamageTypeDisplay.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.dnd5eDamageTypeDisplay.active}}
                            {{#if settingLocks.dnd5eDamageTypeDisplay.canManage}}
                                <a class="hud-lock-icon {{settingLocks.dnd5eDamageTypeDisplay.type}}" data-setting-key="dnd5eDamageTypeDisplay" title="{{settingLocks.dnd5eDamageTypeDisplay.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.dnd5eDamageTypeDisplay.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.dnd5eDamageTypeDisplay.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.dnd5eDamageTypeDisplay.type}}" title="{{settingLocks.dnd5eDamageTypeDisplay.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Damage type display</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Choose how damage types are displayed on action buttons: compact subtly colored icons, icons with text, or written text only.</span>
                </div>
                <div class="hud-cfg-control">
                    <select class="hud-cfg-select" name="dnd5eDamageTypeDisplay" {{#if settingLocks.dnd5eDamageTypeDisplay.disabled}}disabled{{/if}}>
                        <option value="icons" {{#if (eq dnd5eDamageTypeDisplay "icons")}}selected{{/if}}>Icons only</option>
                        <option value="both" {{#if (eq dnd5eDamageTypeDisplay "both")}}selected{{/if}}>Icons and text</option>
                        <option value="text" {{#if (eq dnd5eDamageTypeDisplay "text")}}selected{{/if}}>Text only</option>
                    </select>
                </div>
            </div>

            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        <label class="hud-cfg-label">Auto-favorite NPC actions</label>
                        <span class="hud-cfg-scope world" title="Applies to every player at the table">WORLD</span>
                    </div>
                    <span class="hud-cfg-hint">Automatically favorite attack, damage, and save activities when an NPC token with no favorites is placed on the canvas.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="dnd5eAutoFavoriteNpcActions" {{#if dnd5eAutoFavoriteNpcActions}}checked{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        <label class="hud-cfg-label">Auto-favorite max features</label>
                        <span class="hud-cfg-scope world" title="Applies to every player at the table">WORLD</span>
                    </div>
                    <span class="hud-cfg-hint">Maximum number of qualifying items or features (with attack, damage, or save activities) an NPC can have to trigger auto-favoriting.</span>
                </div>
                <div class="hud-cfg-control">
                    <div class="hud-cfg-number">
                        <input type="number" name="dnd5eAutoFavoriteNpcMax" value="{{dnd5eAutoFavoriteNpcMax}}" min="1" max="20" step="1">
                        <span class="hud-cfg-number-unit">MAX</span>
                    </div>
                </div>
            </div>
            {{/if}}
        </div>
    </section>

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Display</span><span data-cfg-count="rows"></span>
        </div>
        <div class="hud-cfg-list">
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        <label class="hud-cfg-label">Visibility trigger</label>
                        <span class="hud-cfg-scope world" title="Applies to every player at the table">WORLD</span>
                    </div>
                    <span class="hud-cfg-hint">When should the Action HUD be shown on the canvas?</span>
                </div>
                <div class="hud-cfg-control">
                    <select class="hud-cfg-select" name="actionMenuVisibility">
                        <option value="always" {{#if (eq actionMenuVisibility "always")}}selected{{/if}}>Token selected</option>
                        <option value="combat" {{#if (eq actionMenuVisibility "combat")}}selected{{/if}}>In combat only</option>
                        <option value="hover" {{#if (eq actionMenuVisibility "hover")}}selected{{/if}}>On token hover</option>
                    </select>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.fadeWhenIdle.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.fadeWhenIdle.active}}
                            {{#if settingLocks.fadeWhenIdle.canManage}}
                                <a class="hud-lock-icon {{settingLocks.fadeWhenIdle.type}}" data-setting-key="fadeWhenIdle" title="{{settingLocks.fadeWhenIdle.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.fadeWhenIdle.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.fadeWhenIdle.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.fadeWhenIdle.type}}" title="{{settingLocks.fadeWhenIdle.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Fade when idle</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Dim the Action HUD when inactive, respecting core Foundry's Inactive Opacity and Fade Speed settings. Restores full opacity on hover, focus, or when a submenu is open.</span>
                </div>
                <div class="hud-cfg-control">
                    <label class="hud-cfg-switch">
                        <input type="checkbox" role="switch" class="hud-switch-input" name="fadeWhenIdle" {{#if fadeWhenIdle}}checked{{/if}} {{#if settingLocks.fadeWhenIdle.disabled}}disabled{{/if}}>
                        <span class="hud-cfg-switch-track" aria-hidden="true"></span>
                        <span class="hud-cfg-switch-knob" aria-hidden="true"></span>
                    </label>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.actionMenuSubmenuSide.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.actionMenuSubmenuSide.active}}
                            {{#if settingLocks.actionMenuSubmenuSide.canManage}}
                                <a class="hud-lock-icon {{settingLocks.actionMenuSubmenuSide.type}}" data-setting-key="actionMenuSubmenuSide" title="{{settingLocks.actionMenuSubmenuSide.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.actionMenuSubmenuSide.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.actionMenuSubmenuSide.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.actionMenuSubmenuSide.type}}" title="{{settingLocks.actionMenuSubmenuSide.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Submenu expansion direction</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Side on which secondary submenus and item trays unfold.</span>
                </div>
                <div class="hud-cfg-control">
                    <select class="hud-cfg-select" name="actionMenuSubmenuSide" {{#if settingLocks.actionMenuSubmenuSide.disabled}}disabled{{/if}}>
                        <option value="auto" {{#if (eq actionMenuSubmenuSide "auto")}}selected{{/if}}>Automatic</option>
                        <option value="left" {{#if (eq actionMenuSubmenuSide "left")}}selected{{/if}}>Left</option>
                        <option value="right" {{#if (eq actionMenuSubmenuSide "right")}}selected{{/if}}>Right</option>
                    </select>
                </div>
            </div>

            <div class="hud-cfg-row {{#if settingLocks.tooltipPosition.isHard}}hard-locked{{/if}}">
                <div class="hud-cfg-info">
                    <div class="hud-cfg-label-line">
                        {{#if settingLocks.tooltipPosition.active}}
                            {{#if settingLocks.tooltipPosition.canManage}}
                                <a class="hud-lock-icon {{settingLocks.tooltipPosition.type}}" data-setting-key="tooltipPosition" title="{{settingLocks.tooltipPosition.tooltip}}">
                                    <i class="fa-solid {{#if settingLocks.tooltipPosition.isLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
                                </a>
                            {{else if settingLocks.tooltipPosition.isLocked}}
                                <span class="hud-lock-icon {{settingLocks.tooltipPosition.type}}" title="{{settingLocks.tooltipPosition.tooltip}}">
                                    <i class="fa-solid fa-lock"></i>
                                </span>
                            {{/if}}
                        {{/if}}
                        <label class="hud-cfg-label">Tooltip anchor</label>
                        <span class="hud-cfg-scope client" title="Applies to this browser only">CLIENT</span>
                    </div>
                    <span class="hud-cfg-hint">Position item details tooltip adjacent to the button or tracking the mouse cursor.</span>
                </div>
                <div class="hud-cfg-control">
                    <select class="hud-cfg-select" name="tooltipPosition" {{#if settingLocks.tooltipPosition.disabled}}disabled{{/if}}>
                        <option value="anchor" {{#if (eq tooltipPosition "anchor")}}selected{{/if}}>Anchor to HUD item</option>
                        <option value="cursor" {{#if (eq tooltipPosition "cursor")}}selected{{/if}}>Follow cursor</option>
                    </select>
                </div>
            </div>
        </div>
    </section>

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Excluded actor types</span><span data-cfg-count="checked"></span>
            <span class="hud-cfg-scope world hud-cfg-group-scope" title="Applies to every player at the table">WORLD</span>
        </div>
        <div class="hud-cfg-list hud-cfg-chips-box">
            <span class="hud-cfg-hint">The HUD stays hidden while you control a checked actor type.</span>
            <div class="hud-chip-group">
                {{#each allActorTypes}}
                <label class="hud-chip {{#if this.checked}}active{{/if}}">
                    <input type="checkbox" name="excludedActorTypes.{{this.value}}" {{#if this.checked}}checked{{/if}}>
                    <span class="hud-chip-tick" aria-hidden="true"></span>{{this.value}}
                </label>
                {{/each}}
            </div>
        </div>
    </section>

</div>
