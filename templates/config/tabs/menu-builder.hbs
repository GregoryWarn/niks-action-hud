<div class="hud-tab-pane {{#if isMenuTab}}active{{/if}}" data-tab="menu">

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-bar">
            <div class="hud-cfg-group-head">
                <span class="hud-cfg-group-title">Categories</span><span>· {{customMenu.length}}</span>
            </div>
            <span class="hud-cfg-spacer"></span>
            <button type="button" class="hud-cfg-btn" data-action="addCategory">+ ADD CATEGORY</button>
        </div>
        <span class="hud-cfg-group-desc">Customize the order, appearance, and contents of category buttons on your Action HUD.</span>

        <div class="hud-cfg-list hud-categories-list">
            {{#each customMenu}}
            <div class="hud-category-card {{#if this._collapsed}}collapsed{{/if}}" draggable="true" data-cat-index="{{@index}}">
                <input type="hidden" name="customMenu.{{@index}}.id" value="{{this.id}}">
                <input type="hidden" name="customMenu.{{@index}}.systemId" value="{{this.systemId}}">
                <input type="hidden" name="customMenu.{{@index}}.type" value="{{this.type}}">
                <input type="hidden" name="customMenu.{{@index}}.useSidebar" value="{{this.useSidebar}}">

                <div class="hud-cat-header" data-action="toggleCollapseCategory">
                    <i class="fas fa-grip-vertical hud-cat-grip" title="Drag to reorder" aria-hidden="true"></i>
                    <span class="hud-cat-icon-badge">{{nahCategoryIcon this "fas fa-folder"}}</span>
                    <span class="hud-cat-title">
                        <span class="hud-cat-name">{{#if this.displayLabel}}{{this.displayLabel}}{{else if this.label}}{{this.label}}{{else}}Unnamed Category{{/if}}</span>
                        <span class="hud-cat-kind">{{#if this.systemId}}SYSTEM{{else}}CUSTOM{{/if}}</span>
                        {{#if this.tabs.length}}<span class="hud-cat-count">{{this.tabs.length}} {{#if (eq this.tabs.length 1)}}SUBMENU{{else}}SUBMENUS{{/if}}</span>{{/if}}
                    </span>
                    <span class="hud-cat-actions">
                        {{#unless this.systemId}}
                        <button type="button" class="hud-cat-action danger" data-action="removeCategory" title="Delete category" aria-label="Delete category">✕</button>
                        {{/unless}}
                        <button type="button" class="hud-cat-action hud-cat-chevron" data-action="toggleCollapseCategory" title="Expand or collapse" aria-label="Expand or collapse">▾</button>
                    </span>
                </div>

                <div class="hud-cat-body">
                    <div class="hud-cat-fields">
                        <label class="hud-cfg-field">
                            <span class="hud-cfg-field-label">Category label</span>
                            <input type="text" class="hud-cfg-text" name="customMenu.{{@index}}.label" value="{{this.label}}">
                        </label>
                        <div class="hud-cfg-field">
                            <span class="hud-cfg-field-label">{{localize "NAH.IconPicker.Field.Label"}}</span>
                            <button type="button" class="hud-icon-field" data-action="pickCategoryIcon" title="{{localize "NAH.IconPicker.Field.Open"}}" aria-label="{{localize "NAH.IconPicker.Field.Open"}}">
                                <span class="hud-icon-field-preview">{{nahCategoryIcon this "fa-regular fa-square"}}</span>
                                <span class="hud-icon-field-value">{{#if this.img}}{{this.img}}{{else if this.icon}}{{this.icon}}{{else}}{{localize "NAH.IconPicker.Field.None"}}{{/if}}</span>
                                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                            </button>
                            <input type="hidden" name="customMenu.{{@index}}.icon" value="{{this.icon}}">
                            <input type="hidden" name="customMenu.{{@index}}.img" value="{{this.img}}">
                        </div>
                        <label class="hud-cfg-field hud-cat-field-wide">
                            <span class="hud-cfg-field-label">Button background</span>
                            <span class="hud-cfg-input-with-button">
                                <input type="text" class="hud-cfg-text mono" name="customMenu.{{@index}}.buttonImg" value="{{this.buttonImg}}" placeholder="path/to/bg.png">
                                <button type="button" class="hud-cfg-btn hud-cfg-btn-square" data-file-picker="customMenu.{{@index}}.buttonImg" title="Browse files" aria-label="Browse files"><i class="fa-solid fa-folder-open" aria-hidden="true"></i></button>
                            </span>
                        </label>
                    </div>

                    {{#unless this.systemId}}
                    <div class="hud-sub-section">
                        <div class="hud-cfg-group-bar">
                            <div class="hud-cfg-group-head hud-sub-head">
                                <span class="hud-cfg-group-title">Submenus</span><span>· {{#if this.tabs.length}}{{this.tabs.length}}{{else}}0{{/if}}</span>
                            </div>
                            <span class="hud-cfg-spacer"></span>
                            <button type="button" class="hud-cfg-btn hud-cfg-btn-sm" data-action="addSubCategory">+ ADD SUBMENU</button>
                        </div>
                        {{#if this.tabs.length}}
                        <div class="hud-sub-list">
                            {{#each this.tabs}}
                            <div class="hud-sub-card" data-tab-index="{{@index}}">
                                <div class="hud-sub-card-header">
                                    <input type="text" class="hud-cfg-text" name="customMenu.{{@../index}}.tabs.{{@index}}.label" value="{{this.label}}" placeholder="Healing potions" aria-label="Submenu label">
                                    <button type="button" class="hud-cfg-btn-delete" data-action="removeSubCategory" title="Delete submenu" aria-label="Delete submenu">✕</button>
                                </div>
                                {{#if this.items.length}}
                                <div class="hud-item-list">
                                    {{#each this.items}}
                                    <span class="hud-item-pill" data-item-index="{{@index}}">
                                        {{#if this.img}}<img src="{{this.img}}" class="hud-item-thumb" alt="">{{/if}}
                                        {{this.name}}
                                        <button type="button" class="hud-item-remove" data-action="removeItem" aria-label="Remove item">✕</button>
                                    </span>
                                    {{/each}}
                                </div>
                                {{else}}
                                <span class="hud-sub-empty">No items in {{this.label}} yet. Drag items from a character sheet onto this tray.</span>
                                {{/if}}
                            </div>
                            {{/each}}
                        </div>
                        {{/if}}
                    </div>
                    {{/unless}}
                </div>
            </div>
            {{/each}}
        </div>
    </section>

</div>
