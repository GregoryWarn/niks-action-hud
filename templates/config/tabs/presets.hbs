<div class="hud-tab-pane {{#if isPresetsTab}}active{{/if}}" data-tab="presets">

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Configuration presets</span><span>· {{#if configPresets.length}}{{configPresets.length}}{{else}}0{{/if}} saved</span>
        </div>
        <span class="hud-cfg-group-desc">Save and restore entire HUD configurations (themes, behaviors, custom menus) within this world.</span>
        <div class="hud-cfg-list">
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Save current as preset</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <input type="text" class="hud-cfg-text hud-cfg-text-wide" name="newConfigPresetName" placeholder="Gritty Dark">
                    <button type="button" class="hud-cfg-btn" data-action="saveConfigPreset">SAVE</button>
                </div>
            </div>
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Load or delete preset</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <select class="hud-cfg-select hud-cfg-text-wide" name="loadConfigPresetSelect" aria-label="Select a saved preset">
                        <option value="">Select a saved preset</option>
                        {{#each configPresets}}
                        <option value="{{this}}">{{this}}</option>
                        {{/each}}
                    </select>
                    <button type="button" class="hud-cfg-btn" data-action="loadConfigPreset">LOAD</button>
                    <button type="button" class="hud-cfg-btn hud-cfg-btn-danger hud-cfg-btn-square" data-action="deleteConfigPreset" title="Delete" aria-label="Delete preset"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    </section>

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Menu layout presets</span><span>· {{#if actionMenuPresets.length}}{{actionMenuPresets.length}}{{else}}0{{/if}} saved</span>
        </div>
        <span class="hud-cfg-group-desc">Save and switch category order and submenu configurations independently from themes.</span>
        <div class="hud-cfg-list">
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Save menu layout</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <input type="text" class="hud-cfg-text hud-cfg-text-wide" name="newActionMenuPresetName" placeholder="Caster Focus">
                    <button type="button" class="hud-cfg-btn" data-action="saveActionMenuPreset">SAVE</button>
                </div>
            </div>
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Load or delete layout</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <select class="hud-cfg-select hud-cfg-text-wide" name="loadActionMenuPresetSelect" aria-label="Select a layout preset">
                        <option value="">Select a layout preset</option>
                        {{#each actionMenuPresets}}
                        <option value="{{this}}">{{this}}</option>
                        {{/each}}
                    </select>
                    <button type="button" class="hud-cfg-btn" data-action="loadActionMenuPreset">LOAD</button>
                    <button type="button" class="hud-cfg-btn hud-cfg-btn-danger hud-cfg-btn-square" data-action="deleteActionMenuPreset" title="Delete" aria-label="Delete preset"><i class="fa-solid fa-trash-can" aria-hidden="true"></i></button>
                </div>
            </div>
        </div>
    </section>

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Import and export</span>
        </div>
        <span class="hud-cfg-group-desc">Backup configurations as downloadable JSON files, or package custom themes as ZIP archives.</span>
        <div class="hud-cfg-list">
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Configuration file · JSON</span>
                    <span class="hud-cfg-hint narrow">Export all settings, colors, anchors, and menus to JSON, or import on another world or machine.</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <button type="button" class="hud-cfg-btn" data-action="exportConfigPresetFile"><i class="fa-solid fa-download" aria-hidden="true"></i>EXPORT</button>
                    <button type="button" class="hud-cfg-btn" data-action="importConfigPresetFile"><i class="fa-solid fa-upload" aria-hidden="true"></i>IMPORT</button>
                </div>
            </div>
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Theme package · ZIP</span>
                    <span class="hud-cfg-hint narrow">Packs the active theme settings and all referenced local graphics into an archive package.</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <button type="button" class="hud-cfg-btn" data-action="exportTheme"><i class="fa-solid fa-download" aria-hidden="true"></i>EXPORT</button>
                    <button type="button" class="hud-cfg-btn" data-action="importTheme"><i class="fa-solid fa-upload" aria-hidden="true"></i>IMPORT</button>
                </div>
            </div>
        </div>
    </section>

    <section class="hud-cfg-group">
        <div class="hud-cfg-group-head">
            <span class="hud-cfg-group-title">Reset</span>
        </div>
        <span class="hud-cfg-group-desc">Restore default module settings section-by-section, or execute a clean factory reset.</span>
        <div class="hud-cfg-list">
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Appearance</span>
                    <span class="hud-cfg-hint narrow">Theme, scale, typography and preview options.</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <button type="button" class="hud-cfg-btn hud-cfg-btn-danger" data-action="reset" data-scope="appearance">RESET</button>
                </div>
            </div>
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Behavior</span>
                    <span class="hud-cfg-hint narrow">Every setting on the General tab.</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <button type="button" class="hud-cfg-btn hud-cfg-btn-danger" data-action="reset" data-scope="behavior">RESET</button>
                </div>
            </div>
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Menu layout</span>
                    <span class="hud-cfg-hint narrow">Category order, custom categories and submenus.</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <button type="button" class="hud-cfg-btn hud-cfg-btn-danger" data-action="reset" data-scope="menu">RESET</button>
                </div>
            </div>
            <div class="hud-cfg-row">
                <div class="hud-cfg-info">
                    <span class="hud-cfg-label">Factory reset</span>
                    <span class="hud-cfg-hint narrow">Every section above, at once. This cannot be undone.</span>
                </div>
                <div class="hud-cfg-control hud-cfg-actions">
                    <button type="button" class="hud-cfg-btn hud-cfg-btn-danger-fill" data-action="reset" data-scope="all">FACTORY RESET</button>
                </div>
            </div>
        </div>
    </section>

</div>
